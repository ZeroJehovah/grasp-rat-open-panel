[Unit]
Description=Finalize yesterday's Grasp Rat daily quota
After=grasp-rat-projector.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/grasp-rat-open-panel/src
EnvironmentFile=-/home/ubuntu/grasp-rat-open-panel/.env
ExecStart=/opt/node-v20.19.5-linux-arm64/bin/node commands/finalize-day.js
NoNewPrivileges=true
PrivateTmp=true
