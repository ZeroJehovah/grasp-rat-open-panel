[Unit]
Description=Grasp Rat Open Panel retention and cleanup
After=grasp-rat-projector.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/grasp-rat-open-panel/src
EnvironmentFile=/home/ubuntu/grasp-rat-open-panel/.env
ExecStart=/opt/node-v20.19.5-linux-arm64/bin/node commands/retention.js --raw-dir /home/ubuntu/grasp-rat-open-panel/data/raw-snapshots --queue-dir /home/ubuntu/grasp-rat-open-panel/data/spool --raw-hours 24 --metadata-days 62
NoNewPrivileges=true
PrivateTmp=true
