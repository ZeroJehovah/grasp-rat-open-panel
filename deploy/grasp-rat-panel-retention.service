[Unit]
Description=Grasp Rat Open Panel retention and cleanup
After=grasp-rat-projector.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/grasp-rat-open-panel/src
EnvironmentFile=/home/ubuntu/grasp-rat-open-panel/.env
ExecStart=/home/ubuntu/.local/node-v22.20.0-linux-arm64/bin/node commands/retention.js --raw-dir /home/ubuntu/grasp-rat-open-panel/data/raw-snapshots --queue-dir /home/ubuntu/grasp-rat-open-panel/data/spool --raw-hours 24 --metadata-days 62 --processed-receipt-hours 1
NoNewPrivileges=true
PrivateTmp=true
