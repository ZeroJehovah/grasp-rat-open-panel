[Unit]
Description=Grasp Rat Open Panel multi-egress snapshot collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/grasp-rat-open-panel/src
ExecStart=/opt/node-v20.19.5-linux-arm64/bin/node snapshot-collector.js --interval-ms 15000 --output-dir /home/ubuntu/grasp-rat-open-panel/data/raw-snapshots --queue-dir /home/ubuntu/grasp-rat-open-panel/data/spool --state-file /home/ubuntu/grasp-rat-open-panel/data/collector-state.json --egress-config /home/ubuntu/grasp-rat-open-panel/src/deploy/egresses.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/home/ubuntu/grasp-rat-open-panel/data

[Install]
WantedBy=default.target
