[Unit]
Description=Grasp Rat Open Panel health and lag check
Wants=network-online.target
After=network-online.target postgresql.service grasp-rat-panel-api.service grasp-rat-projector.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/grasp-rat-open-panel/src
EnvironmentFile=-/home/ubuntu/grasp-rat-open-panel/.env
Environment=GRASP_RAT_PANEL_EGRESS_CONFIG=/home/ubuntu/grasp-rat-open-panel/src/deploy/egresses.json
ExecStart=/opt/node-v20.19.5-linux-arm64/bin/node commands/health-check.js
NoNewPrivileges=true
PrivateTmp=true
